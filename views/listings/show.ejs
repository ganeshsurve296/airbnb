<%layout("/layouts/boilerplate.ejs")%>
    <script>
        const mapToken = "<%= process.env.MAP_TOKEN%>";
        const listing = <%- JSON.stringify(listing)%>;
    </script>

    <body>
        <div class="row">
            <div class="col-8 offset-2">
                <div class="row">
                    <h2><b>
                            <%=listing.title%>
                        </b></h2>
                    <div class="card show-card ">
                        <div class="row">
                            <div class="col-6 offset-2">
                                <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing img">
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="card-text">Owned By : <i>
                                    <%=listing.owner.username%>
                                </i></p>
                            <p class="card-text">
                                <%=listing.description%>
                            </p>
                            <p class="card-text">&#8377; <%=listing.price.toLocaleString("en-IN")%> /- </p>
                            <p class="card-text">
                                <%=listing.location%>
                            </p>
                            <p class="card-text">
                                <%=listing.country%>
                            </p>

                        </div><br>
                        <%if(currUser && currUser._id.equals(listing.owner._id)) {%>
                            <div class="btns">
                                <form method="get" action="/listings/<%=listing._id%>/edit" class="ms-4">
                                    <button class="btn btn-dark edit-btn">Edit</button>
                                </form>

                                <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE" class="ms-4">
                                    <button class="btn btn-dark">DELETE</button>
                                </form>
                            </div>
                            <% } %>
                                <br>
                                <hr>
                                <%if(currUser) {%>
                                    <div class="col-6 offset-2">
                                        <h4>Leave review</h4>
                                        <form action="/listings/<%=listing.id%>/reviews" method="post" novalidate
                                            class="needs-validation">
                                            <!-- <div class="mb-3 mt-3">
                                                
                                                <p> 1 <input type="range" min="1" max="5" id="rating"
                                                        name="">5</p>
                                            </div> -->
                                            <div class="mb-3 mt-3">
                                                <label for="rating" class="form-label">Rating</label>
                                                <fieldset class="starability-slot">

                                                    <input type="radio" id="no-rate" class="input-no-rate"
                                                        name="review[rating]" value="1" checked
                                                        aria-label="No rating." />
                                                    <input type="radio" id="first-rate1" name="review[rating]"
                                                        value="1" />
                                                    <label for="first-rate1" title="Terrible">1 star</label>
                                                    <input type="radio" id="first-rate2" name="review[rating]"
                                                        value="2" />
                                                    <label for="first-rate2" title="Not good">2 stars</label>
                                                    <input type="radio" id="first-rate3" name="review[rating]"
                                                        value="3" />
                                                    <label for="first-rate3" title="Average">3 stars</label>
                                                    <input type="radio" id="first-rate4" name="review[rating]"
                                                        value="4" />
                                                    <label for="first-rate4" title="Very good">4 stars</label>
                                                    <input type="radio" id="first-rate5" name="review[rating]"
                                                        value="5" />
                                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                                </fieldset>
                                            </div>
                                            <div class="mb-3 mt-3">
                                                <lable for="comment" class="form-label">Comment</lable>
                                                <textarea id=comment name="review[comment]" cols="50" rows="5"
                                                    placeholder="Leave Comment here !" class="form-control"
                                                    required></textarea>
                                                <div class="invalid-feedback">Enter valid review</div>
                                            </div>
                                            <button class="btn btn-outline-dark">Submit</button>
                                        </form>
                                    </div>
                                    <hr>
                                    <% } %>
                                        <%if(listing.reviews.length>0){%>

                                            <p><b>All reviews</b></p>
                                            <div class="row">
                                                <% for(review of listing.reviews) {%>
                                                    <div class="card col-5 ms-3 mb-3">
                                                        <div class="card-body">
                                                            <div class="card-title"><i
                                                                    class="fa-regular fa-circle-user"></i><b>
                                                                    <%=review.author.username%>
                                                                </b></div>
                                                            <p class="starability-result card-text"
                                                                data-rating="<%=review.rating%>"></p>
                                                            <div class="card-text">
                                                                <%=review.comment%>
                                                            </div>

                                                        </div>
                                                        <form method="post" class="mb-3 ms-3 "
                                                            action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                                                            <button class="btn btn-dark btn-sm">Delete</button>
                                                        </form>
                                                    </div>
                                                    <%}%>
                                            </div>
                                            <% } %>



                    </div>



                </div>
                <div class="col-6 ">
                    <h3>Where you'll be !</h3>
                    <div id="map" class="offset-3"></div>
                </div>

            </div>
            <script src="/js/map.js"></script>
    </body>