<%layout("/layouts/boilerplate.ejs")%>
<body>
    <div class="row">
        <div class="col-8 offset-2">
    <div class="row">
    <h2 ><b><%=listing.title%></b></h2>
    <div class="card show-card " >
        <div class="row">
            <div class="col-6 offset-2">
                <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing img">
            </div>
        </div>
        <div class="card-body">
            
            <p class="card-text"><%=listing.description%></p>
            &#8377; <%=listing.price.toLocaleString("en-IN")%> /- <br>
            <%=listing.location%><br>
            <%=listing.country%>

        </div><br>
        <div class="btns">
            <form method="get" action="/listings/<%=listing._id%>/edit" class="ms-4">
                <button class="btn btn-dark edit-btn">Edit</button>
            </form>
    
            <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE" class="ms-4">
                <button class="btn btn-dark">DELETE</button>
            </form>
        </div>
        <hr>
        <div class="col-6 offset-2">
            <h4>Leave review</h4>
            <form action = "/listings/<%=listing.id%>/review" method = "post" novalidate class="needs-validation">
                <div class = "mb-3 mt-3">
                    <label for = "rating" class ="form-label">Rating</label>
                    <p> 1 <input type = "range" min = "1" max = "5" id = "rating" name = "review[rating]" >5</p>
                </div>
                <div class = "mb-3 mt-3">
                    <lable for = "comment" class ="form-label">Comment</lable>
                    <textarea id = comment  name = "review[comment]" cols = "50" rows = "5" placeholder="Leave Comment here !" class="form-control" required></textarea>
                    <div class="invalid-feedback">Enter valid review</div>
                </div>
                <button class = "btn btn-outline-dark">Submit</button>
            </form> 
        </div>
        <hr>
        <p><b>All reviews</b></p>
        <div class="row">
            <% for(review of listing.reviews) {%>
                <div class="card col-5 ms-3 mb-3">
                    <div class="card-body">
                        <div class="card-title"><i class="fa-regular fa-circle-user"></i><b> joff classen</b></div>
                        <div class="card-text"><%=review.comment%></div>
                        <div class="card-text"><%=review.rating%> stars</div>

                    </div>
                    <form method = "post" class="mb-3 ms-3 " action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE"><button class = "btn btn-dark btn-sm">Delete</button></form>
                </div>
            <%}%>
        </div>
       
    </div>
    
    
    </div>
    </div>
</body>
