<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wander Lust</title>
</head>
<body>
    <h3>Enter details to Add </h3>
    <form method = "POST" action="/listings">
        <input name ="listing[title]" placeholder = "Enter title">
        <br><br>
        <textarea rows = 5 cols = 20 name ="listing[description]" placeholder = "Enter description"></textarea>
        <br><br>
        <input name ="listing[price]" placeholder = "Enter Price per night" type = "number">
        <br><br>
        <input name ="listing[img]" placeholder = "Enter image link/url">
        <br><br>
        <input name ="listing[location]" placeholder = "Enter location">
        <br><br>
        <input name ="listing[country]" placeholder = "Enter country">
        <br><br>
        <button>Submitt !</button>
    </form>
</body>
</html>